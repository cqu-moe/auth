{
  "name": "auth",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:frontend && wrangler deploy --var QUICKLOGIN_SERVER_BUILD:$(git rev-parse HEAD) --var RELEASE:$(git rev-parse HEAD)",
    "typecheck": "tsc --noEmit",
    "typecheck:do": "tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:do": "vitest run -c vitest.workers.config.mts",
    "generate:api": "tsx scripts/generate-api.ts",
    "check:api": "tsx scripts/check-api.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "lint:api": "redocly lint --config .redocly.yaml docs/api/openapi.json docs/api/cloudflare.openapi.json",
    "db:migrate:local": "wrangler d1 migrations apply auth-cqu-moe-db --local",
    "build:frontend": "pnpm --dir frontend run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cqu-moe/auth.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cqu-moe/auth/issues"
  },
  "homepage": "https://github.com/cqu-moe/auth#readme",
  "dependencies": {
    "@better-auth/oauth-provider": "^1.6.11",
    "@cloudflare/containers": "^0.3.7",
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "^1.6.11",
    "better-auth-cloudflare": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.22",
    "postal-mime": "^2.7.4",
    "posthog-node": "^5.52.4",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.9",
    "@cloudflare/workers-types": "^4.20260523.1",
    "@redocly/cli": "2.52.1",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "28.1.0",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0"
  }
}

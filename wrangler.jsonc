{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cqu-moe-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "placement": { "hostname": "sso.cqu.edu.cn" },

  "vars": {
    "BIND_EMAIL_DOMAIN": "cquotp.com"
  },

  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [{
    "binding": "DATABASE",
    "database_name": "auth-cqu-moe-db",
    "database_id": "135e9272-b7f6-4672-925a-f813dba5ad40",
    "migrations_dir": "drizzle/migrations"
  }],

  "kv_namespaces": [{
    "binding": "KV",
    "id": "6b00aa8948df452d956bd948b4c0b603"
  }],

  "durable_objects": {
    "bindings": [
      {
        "name": "CQU_SESSION",
        "class_name": "CquSessionDO"
      },
      {
        "name": "CQU_LOGIN",
        "class_name": "CquLoginContainer"
      }
    ]
  },

  "containers": [{
    "class_name": "CquLoginContainer",
    "image": "./container/Dockerfile",
    "max_instances": 5,
    "instance_type": "basic",
    // 容器登录默认就近请求来源(近中国)→ 踩 CQU 间歇封锁的近机房 CF 出口 IP。
    // 钉到北美西部(海外干净 IP, 实测海外可登)绕开封锁; 登录异步重型(2FA 邮件主导),
    // 跨洋延迟可忽略。先观测几天, 不行再换区(如 WEUR)。
    "constraints": { "regions": ["WNAM"] }
  }],

  // Workers VPC Service binding (beta): DO 经此私有连回国内 VPS 登录节点上的
  // container/server.py(青果住宅代理本地连 CQU, 消除验证码)。「连 CQU」四处
  // 出站(/run /service-ticket /keepalive /code)走 LOGIN_NODE.fetch 发往该节点。
  // service_id 为占位符, Phase 3 部署时用 `wrangler vpc service create` 创建后回填。
  "vpc_services": [{
    "binding": "LOGIN_NODE",
    "service_id": "PLACEHOLDER_VPC_SERVICE_ID",
    "remote": true
  }],

  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["CquSessionDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CquLoginContainer"]
    }
  ],

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cqu-moe-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "placement": { "hostname": "sso.cqu.edu.cn" },

  "vars": {
    "BIND_EMAIL_DOMAIN": "cquotp.com",
    "QUICKLOGIN_DEVICE_MODE": "on",
    "QUICKLOGIN_CLIENT_ID": "cqu-quicklogin-chrome",
    "QUICKLOGIN_EXTENSION_ORIGIN": "chrome-extension://igfidegfgfoofnoncpmbcokbffjmmook",
    // 浏览器后端已固定为 Cloudflare APAC Containers(2026-09-08 全量切换,
    // 2026-09-09 移除腾讯云节点绑定 LOGIN_NODE 与 node 回退路径)。
  },

  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [{
    "binding": "DATABASE",
    "database_name": "auth-cqu-moe-db",
    "database_id": "135e9272-b7f6-4672-925a-f813dba5ad40",
    "migrations_dir": "drizzle/migrations"
  }],

  "kv_namespaces": [{
    "binding": "KV",
    "id": "6b00aa8948df452d956bd948b4c0b603"
  }],

  "queues": {
    "consumers": [{
      "queue": "schedule-notifications",
      "max_batch_size": 10,
      "max_batch_timeout": 30,
      "max_retries": 5,
      "max_concurrency": 2
    }]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "CQU_SESSION",
        "class_name": "CquSessionDO"
      },
      {
        "name": "CQU_LOGIN",
        "class_name": "CquLoginContainer"
      },
      {
        "name": "CQU_QUICKLOGIN_ACCOUNT",
        "class_name": "CquQuickloginAccountDO"
      },
      {
        "name": "CQU_QUICKLOGIN_DEVICE",
        "class_name": "CquQuickloginDeviceDO"
      }
    ]
  },

  "containers": [{
    "class_name": "CquLoginContainer",
    "image": "./container/Dockerfile",
    "max_instances": 5,
    "instance_type": "basic",
    // 全量迁移目标区域: APAC(实测 CAS/aTrust 全链路可用, 见 docs 实测报告)。
    // max_instances=5 只是本地示例值, 生产定值由 Task 10 按实际负载计算后调整。
    "constraints": { "regions": ["APAC"] }
  }],

  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["CquSessionDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CquLoginContainer"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["CquQuickloginAccountDO", "CquQuickloginDeviceDO"]
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cqu-moe-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "placement": { "hostname": "sso.cqu.edu.cn" },

  "vars": {
    "BIND_EMAIL_DOMAIN": "cquotp.com"
  },

  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [{
    "binding": "DATABASE",
    "database_name": "auth-cqu-moe-db",
    "database_id": "135e9272-b7f6-4672-925a-f813dba5ad40",
    "migrations_dir": "drizzle/migrations"
  }],

  "kv_namespaces": [{
    "binding": "KV",
    "id": "6b00aa8948df452d956bd948b4c0b603"
  }],

  "durable_objects": {
    "bindings": [
      {
        "name": "CQU_SESSION",
        "class_name": "CquSessionDO"
      },
      {
        "name": "CQU_LOGIN",
        "class_name": "CquLoginContainer"
      }
    ]
  },

  "containers": [{
    "class_name": "CquLoginContainer",
    "image": "./container/Dockerfile",
    "max_instances": 5,
    "instance_type": "basic"
  }],

  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["CquSessionDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CquLoginContainer"]
    }
  ],

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}

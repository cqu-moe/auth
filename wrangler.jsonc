{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cqu-moe-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "placement": { "hostname": "sso.cqu.edu.cn" },

  "vars": {
    "BIND_EMAIL_DOMAIN": "cquotp.com",
    // 全局浏览器后端开关(名称与 src/types.ts Env.CQU_BROWSER_BACKEND 逐字一致)。
    // 准备版本固定 node: 新登录/取票/保活/采集仍走国内节点; Task 11 单独一次发布
    // 把它改为 cloudflare 对全部用户启用 APAC(不做用户灰度)。已建立的持久 route
    // 不受此值影响, 仍按各自 route 完成。
    "CQU_BROWSER_BACKEND": "node"
  },

  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [{
    "binding": "DATABASE",
    "database_name": "auth-cqu-moe-db",
    "database_id": "135e9272-b7f6-4672-925a-f813dba5ad40",
    "migrations_dir": "drizzle/migrations"
  }],

  "kv_namespaces": [{
    "binding": "KV",
    "id": "6b00aa8948df452d956bd948b4c0b603"
  }],

  "queues": {
    "consumers": [{
      "queue": "schedule-notifications",
      "max_batch_size": 10,
      "max_batch_timeout": 30,
      "max_retries": 5,
      "max_concurrency": 2
    }]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "CQU_SESSION",
        "class_name": "CquSessionDO"
      },
      {
        "name": "CQU_LOGIN",
        "class_name": "CquLoginContainer"
      }
    ]
  },

  "containers": [{
    "class_name": "CquLoginContainer",
    "image": "./container/Dockerfile",
    "max_instances": 5,
    "instance_type": "basic",
    // 全量迁移目标区域: APAC(实测 CAS/aTrust 全链路可用, 见 docs 实测报告)。
    // max_instances=5 只是本地示例值, 生产定值由 Task 10 按实际负载计算后调整。
    "constraints": { "regions": ["APAC"] }
  }],

  // Workers VPC Service binding (beta): DO 经此私有连回国内 VPS 登录节点上的
  // container/server.py(青果住宅代理本地连 CQU, 消除验证码)。「连 CQU」四处出站
  // (/run /service-ticket /keepalive /code)均走 LOGIN_NODE.fetch 发往该节点。
  // service_id = VPC service `cqu-login`(type http → 127.0.0.1:8080, tunnel 35d48aa0-...,
  // 由 `wrangler vpc service create` 创建);改 tunnel/目标需同步重建该 service。
  "vpc_services": [{
    "binding": "LOGIN_NODE",
    "service_id": "019ed036-ce37-7220-a37c-973903853f78",
    "remote": true
  }],

  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["CquSessionDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CquLoginContainer"]
    }
  ],

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
